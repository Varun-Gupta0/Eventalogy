rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isVendor() {
      return isAuthenticated() && request.auth.token.role == 'vendor';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function notModifying(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ── MASTER DATA ────────────────────────────────────────────────────────

    // users/{userId}
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == 'user';
      allow update: if isAdmin()
        || (isOwner(userId) && notModifying(['role', 'uid']));
      allow delete: if isAdmin();
    }

    // venues/{venueId} — public read for active/verified, admin CRUD
    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // vendors/{vendorId}
    match /vendors/{vendorId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() 
        || (isVendor() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (isVendor()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && notModifying(['verified', 'rating', 'status', 'userId']));
      allow delete: if isAdmin();
    }

    // services/{serviceId}
    match /services/{serviceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // packages/{packageId}
    match /packages/{packageId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // categories/{categoryId}
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // eventTypes/{eventTypeId}
    match /eventTypes/{eventTypeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // locations/{locationId}
    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // venueTypes/{venueTypeId}
    match /venueTypes/{venueTypeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ── TRANSACTION DATA ───────────────────────────────────────────────────

    // events/{eventId}
    match /events/{eventId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // enquiries/{enquiryId}
    match /enquiries/{enquiryId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid)
        || (isVendor() && resource.data.vendorId != null
            && exists(/databases/$(database)/documents/vendors/$(resource.data.vendorId))
            && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid)
        || (isVendor() && resource.data.vendorId != null
            && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // bookings/{bookingId}
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid)
        || (isVendor() && resource.data.vendorId != null
            && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // allocations/{allocationId}
    match /allocations/{allocationId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.assignedBy == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // payments/{paymentId}
    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // reviews/{reviewId}
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── AI DATA ────────────────────────────────────────────────────────────

    // ai_plans/{planId}
    match /ai_plans/{planId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ai_recommendations/{recommendationId}
    match /ai_recommendations/{recommendationId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // agent_tasks/{taskId} — system/admin only
    match /agent_tasks/{taskId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // agent_logs/{logId} — admin only, no user/vendor access
    match /agent_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── SYSTEM DATA ────────────────────────────────────────────────────────

    // notifications/{notificationId} — users see only their own
    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && notModifying(['userId', 'type', 'title', 'message', 'createdAt']);
      allow delete: if isAdmin();
    }

    // audit_logs/{logId} — admin read-only, no user manipulation
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }

    // settings/{settingId} — admin only
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
